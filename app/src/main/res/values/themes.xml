<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The WebView paints the entire UI, so the theme only needs to supply a
         matching window background (avoids a white flash before first paint)
         and get the system bars out of the way. -->
    <style name="Theme.WorkOutMate" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
